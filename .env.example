# ===============================================
# DAZZLING THREADS (DULHA DULHAN HOUSE) - ENV CONFIG
# ===============================================

# Server Configuration
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or local fallback)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dazzling_threads?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=dazzling_threads_super_secret_jwt_key_2026_luxury_brand
JWT_EXPIRES_IN=7d

# Initial Admin Credentials for Seeding
ADMIN_NAME=Royal Administrator
ADMIN_EMAIL=admin@dazzlingthread.com
ADMIN_PASSWORD=Admin@12345

# Cloudinary (Image & Asset CDN)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay (India Luxury Payments Architecture)
RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_KEY_SECRET=rzp_test_sample_key_secret
